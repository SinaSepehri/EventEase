@page "/events/{Id:int}/register"

<PageTitle>Register · EventEase</PageTitle>

@if (evt is not null)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@AppRoutes.Events">Events</a></li>
            <li class="breadcrumb-item"><a href="@AppRoutes.EventDetails(evt.Id)">@evt.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">Register</li>
        </ol>
    </nav>

    @if (confirmed is not null)
    {
        <div class="alert alert-success" role="status">
            <h1 class="h4">You are registered!</h1>
            <p class="mb-0">
                Thanks, @confirmed.FullName. @confirmed.Tickets ticket(s) for
                <strong>@evt.Name</strong> on @evt.Date.ToString("MMM d, yyyy") are confirmed.
                A confirmation will be sent to @confirmed.Email.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="@AppRoutes.MyRegistrations">View my registrations</a>
            <button class="btn btn-outline-primary" @onclick="BackToEvents">Browse more events</button>
        </div>
    }
    else
    {
        <h1>Register for @evt.Name</h1>
        <p class="text-body-secondary">
            @evt.Date.ToString("dddd, MMMM d, yyyy · h:mm tt") · @evt.Location · @evt.SeatsLeft seats left
        </p>

        @if (evt.IsPast)
        {
            <div class="alert alert-secondary">Registration is closed because this event has already taken place.</div>
            <a class="btn btn-outline-primary" href="@AppRoutes.Events">Back to events</a>
        }
        else if (evt.IsFull)
        {
            <div class="alert alert-warning">This event is sold out.</div>
            <a class="btn btn-outline-primary" href="@AppRoutes.Events">Back to events</a>
        }
        else if (existing is not null && !registerSomeoneElse)
        {
            <div class="alert alert-info" role="status">
                You're already registered for this event with @existing.Tickets ticket(s) as @existing.Email.
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="@AppRoutes.MyRegistrations">View my registrations</a>
                <button class="btn btn-outline-secondary" @onclick="() => registerSomeoneElse = true">Register someone else</button>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <RegistrationForm Event="evt" OnRegistered="OnRegistered" PrefillFromSession="!registerSomeoneElse">
                        <a class="btn btn-link" href="@AppRoutes.EventDetails(evt.Id)">Cancel</a>
                    </RegistrationForm>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private EventService EventService { get; set; } = default!;
    [Inject] private AttendanceService Attendance { get; set; } = default!;
    [Inject] private UserSessionState Session { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private Event? evt;
    private RegistrationRecord? existing;
    private RegistrationRecord? confirmed;
    private bool registerSomeoneElse;

    protected override void OnParametersSet()
    {
        evt = EventService.GetById(Id);
        if (evt is null)
        {
            // .NET 10: shows the Router's NotFoundPage and keeps the URL.
            Navigation.NotFound();
            return;
        }

        existing = Session.IsSignedIn ? Attendance.FindActive(Id, Session.Email) : null;
        confirmed = null;
        registerSomeoneElse = false;
    }

    private void OnRegistered(RegistrationRecord record) => confirmed = record;

    private void BackToEvents() => Navigation.NavigateTo(AppRoutes.Events);
}

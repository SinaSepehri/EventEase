<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- Code quality: treat every compiler warning as an error so problems can't slip in unnoticed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Download size: the app shows dates and numbers in one fixed (English) format, so the
         ICU culture data (several MB uncompressed) isn't needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow the test project to use internal types. -->
    <InternalsVisibleTo Include="EventEase.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <!-- Development server only (PrivateAssets=all): not shipped with the published app. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
  </ItemGroup>

</Project>
